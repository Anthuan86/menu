{{!
    @template local_points/leaderboard

    Leaderboard template.

    Context variables required for this template:
    * title - Leaderboard title
    * hasusers - Whether there are users
    * users - Array of users with points

    Example context (json):
    {
        "title": "Top 10",
        "hasusers": true,
        "users": [
            {"rank": 1, "fullname": "John Doe", "points": 500, "userpicture": "<img...>", "iscurrent": true},
            {"rank": 2, "fullname": "Jane Smith", "points": 450, "userpicture": "<img...>", "iscurrent": false}
        ]
    }
}}
<div class="local-points-leaderboard">
    <h4 class="mb-3">{{title}}</h4>

    {{#hasusers}}
    <div class="leaderboard-list">
        {{#users}}
        <div class="leaderboard-item d-flex align-items-center py-2 {{#iscurrent}}bg-light{{/iscurrent}} border-bottom">
            <div class="rank-badge mr-3">
                {{#isfirst}}
                    <span class="badge badge-warning">1</span>
                {{/isfirst}}
                {{#issecond}}
                    <span class="badge badge-secondary">2</span>
                {{/issecond}}
                {{#isthird}}
                    <span class="badge badge-danger">3</span>
                {{/isthird}}
                {{^isfirst}}{{^issecond}}{{^isthird}}
                    <span class="badge badge-light">{{rank}}</span>
                {{/isthird}}{{/issecond}}{{/isfirst}}
            </div>

            <div class="user-info flex-grow-1">
                {{{userpicture}}}
                <span class="ml-2 {{#iscurrent}}font-weight-bold{{/iscurrent}}">
                    {{fullname}}
                    {{#iscurrent}}({{#str}}you, moodle{{/str}}){{/iscurrent}}
                </span>
            </div>

            <div class="points-badge">
                <span class="badge badge-primary">{{points}}</span>
            </div>
        </div>
        {{/users}}
    </div>
    {{/hasusers}}

    {{^hasusers}}
    <p class="text-muted">{{#str}}nopointsyet, local_points{{/str}}</p>
    {{/hasusers}}
</div>
